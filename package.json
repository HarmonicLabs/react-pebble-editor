{
    "name": "react-pebble-editor",
    "version": "0.3.2",
    "description": "React wrap component for monaco pebble editor",
    "scripts": {
        "dev": "vite",
        "types": "tsc --emitDeclarationOnly --project tsconfig.json",
        "build": "vite build && npm run types",
        "preview": "vite preview"
    },
    "main": "dist/react-pebble-editor.umd.js",
    "module": "dist/react-pebble-editor.es.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/react-pebble-editor.es.js",
            "require": "./dist/react-pebble-editor.umd.js"
        }
    },
    "files": [
        "dist",
        "src",
        "README.md"
    ],
    "devDependencies": {
        "@harmoniclabs/pebble": "^0.3.1",
        "@types/node": "^22.12.0",
        "@types/react": "^18.0.0",
        "@types/react-dom": "^18.0.0",
        "@vitejs/plugin-react": "^6.0.0",
        "fs-extra": "^11.3.0",
        "react": "^18.0.0",
        "react-dom": "^18.0.0",
        "typescript": "5.4.5",
        "vite": "^8.0.14"
    },
    "dependencies": {
        "@harmoniclabs/monaco-editor": "^0.3.0"
    }
}
